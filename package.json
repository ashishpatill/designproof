{
  "name": "designproof",
  "private": true,
  "version": "0.1.0",
  "description": "Every AI-built UI has a tell — capture, diagnose, art-direct, reconcile in Cursor.",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -F @designproof/web dev",
    "dev:fixture": "pnpm -F @designproof/generic-app dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm typecheck",
    "typecheck": "pnpm -r typecheck",
    "designproof": "pnpm -F @designproof/cli exec tsx src/cli.ts",
    "dp:build": "pnpm -F @designproof/schema build && pnpm -F @designproof/cli build",
    "capture:fixture": "pnpm -F @designproof/core capture:fixture",
    "diagnose:fixture": "pnpm -F @designproof/core diagnose:fixture",
    "dogfood:web": "pnpm -F @designproof/core exec tsx src/scripts/dogfood-web.ts",
    "verify:directions": "pnpm exec tsx .verification-screenshots/capture-directions.ts",
    "pr:diagnose": "pnpm -F @designproof/schema build && pnpm -F @designproof/core build && pnpm -F @designproof/core exec tsx --tsconfig ../../packages/core/tsconfig.json ../../scripts/pr-diagnose.ts",
    "proof:compare": "pnpm -F @designproof/schema build && pnpm -F @designproof/core build && pnpm -F @designproof/core exec tsx --tsconfig ../../packages/core/tsconfig.json ../../scripts/pr-proof-compare.ts",
    "proof:matrix": "pnpm -F @designproof/schema build && pnpm -F @designproof/core build && pnpm -F @designproof/core exec tsx --tsconfig ../../packages/core/tsconfig.json ../../scripts/pr-proof-matrix.ts",
    "capture:matrix": "pnpm -F @designproof/schema build && pnpm -F @designproof/core build && pnpm -F @designproof/core exec tsx --tsconfig ../../packages/core/tsconfig.json ../../scripts/capture-scenario-matrix.ts",
    "auth:fixture": "pnpm -F @designproof/core exec tsx --tsconfig ../../packages/core/tsconfig.json ../../scripts/mint-fixture-auth.ts",
    "corpus:generate": "python3 scripts/generate-corpus-captures.py",
    "sync:demo-report": "pnpm -F @designproof/core exec tsx ../../scripts/sync-demo-report.ts",
    "deploy:vercel": "bash scripts/deploy-vercel.sh",
    "e2e:studio": "pnpm -F @designproof/core exec tsx ../../scripts/e2e-studio-playwright.ts",
    "eye:shell": "pnpm -F @designproof/core exec tsx ../../scripts/eye-shell-contrast.ts",
    "record:readme-demo": "pnpm -F @designproof/core exec tsx ../../scripts/record-readme-demo.ts",
    "record:template-motion": "pnpm -F @designproof/design-skills exec tsx ../../scripts/record-template-motion.ts",
    "capture:readme-showcase": "pnpm -F @designproof/core exec tsx ../../scripts/capture-readme-showcase.ts",
    "capture:readme-reels": "pnpm -F @designproof/core exec tsx ../../scripts/capture-first5-reels.ts",
    "capture:readme-steps": "pnpm -F @designproof/core exec tsx ../../scripts/capture-readme-steps.ts",
    "media:webp": "bash scripts/optimize-readme-media.sh --prune && bash scripts/optimize-site-media.sh --prune",
    "media:site": "bash scripts/optimize-site-media.sh --prune",
    "research:forensics": "pnpm -F @designproof/core exec tsx ../../scripts/design-research/forensics.ts",
    "research:aggregate": "pnpm -F @designproof/core exec tsx ../../scripts/design-research/aggregate.ts",
    "research:critique": "pnpm -F @designproof/design-skills exec tsx ../../scripts/design-research/critique.ts",
    "research:shots": "pnpm -F @designproof/design-skills exec tsx ../../scripts/design-research/shots.ts",
    "research:audit": "pnpm -F @designproof/design-skills exec tsx ../../scripts/design-research/layout-audit.ts",
    "research:inspect": "pnpm -F @designproof/design-skills exec tsx ../../scripts/design-research/inspect.ts",
    "agency:pipeline": "pnpm -F @designproof/design-skills exec tsx ../../scripts/agency-pipeline/run.ts",
    "agency:run": "pnpm -F @designproof/design-skills exec tsx ../../scripts/agency-pipeline/orchestrate.ts",
    "agency:learn": "pnpm -F @designproof/design-skills exec tsx ../../scripts/agency-pipeline/learn.ts",
    "verify:crease-scorecard": "node scripts/verify-crease-scorecard-align.mjs",
    "browsers:install": "playwright install chromium"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
