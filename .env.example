# Taste engine (Gemini)
GEMINI_API_KEY=your-gemini-api-key

# Cursor-backed redesign drafts (optional; deterministic fallback works without it)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_AGENT_TIMEOUT_MS=75000

# Reserved for richer source-aware diffs (optional)
ANTHROPIC_API_KEY=

# Fixture URLs for local demo
TELL_FIXTURE_URL=http://localhost:3001
TELL_REPORT_ARTIFACT=fixtures/reports/tell-report.json

# Local training-data sink → sibling tell-design-data repo (auto-detected if checked out next to Tell)
# TELL_DESIGN_DATA_REPO=/absolute/path/to/tell-design-data
# Force on/off (default: on in local/dev when repo is found; off on Vercel)
# TELL_TRAINING_DATA=1
# After each write, Tell runs `tell-design-data sync` (disable with 0)
# TELL_TRAINING_DATA_SYNC=0

# Personal design-data companion — DEVELOPER MACHINE ONLY
# (end-user learning is browser UserDesignProfile — not this)
# See research/design-data.README.md — prefer research/design-data.local.json
# TELL_DESIGN_DATA=/absolute/path/to/tell-design-data
# TELL_DEV_CORPUS=1          # required when using TELL_DESIGN_DATA without local json
# TELL_DESIGN_DATA_PULL=1
# TELL_DESIGN_DATA_COMMIT=1
# TELL_DISABLE_DEV_CORPUS=0
# AGENCY_SKIP_LEARN=0

# Authenticated scenario cells — Playwright storageState JSON (cookies / localStorage).
# Mint with: pnpm auth:fixture (fixture must be running on TELL_FIXTURE_URL).
TELL_AUTH_STORAGE_STATE=fixtures/generic-app/auth-storage.json

# Live scenario matrix capture (pnpm capture:matrix)
# TELL_MATRIX_URL=http://localhost:3001
# TELL_MATRIX_ROUTES=/,/pricing,/account
# TELL_MATRIX_PLAN=live
# TELL_MATRIX_OUT=tell-scenario-matrix-live.json
# TELL_MATRIX_COMPARE=1

# Deployment (production)
TELL_DISABLE_REPO_SETUP=1
TELL_REPO_SETUP_TOKEN=
TELL_REPO_ROOT=
TELL_CAPTURE_TIMEOUT_MS=60000

# Hybrid: Vercel UI → capture backend (set on Vercel after backend deploy)
# Example: https://tell-capture.onrender.com
TELL_CAPTURE_API_URL=
# Required on both web and capture host when the capture API is exposed beyond loopback
TELL_CAPTURE_API_TOKEN=

# Neon Postgres — preferred durable store for /api/reports/share (survives Vercel cold starts)
# Create a project at https://console.neon.tech → copy the connection string.
# On Vercel: Storage → Create Database → Neon (or paste DATABASE_URL in Project → Settings → Env).
DATABASE_URL=
# Aliases also accepted: POSTGRES_URL, POSTGRES_PRISMA_URL, NEON_DATABASE_URL

# Vercel Blob — optional fallback for durable share links (auto-injected when a Blob store is linked)
BLOB_READ_WRITE_TOKEN=

# GitHub Actions — repo variable for PR preview diagnosis (Settings → Secrets and variables → Actions → Variables)
# Set TELL_PREVIEW_URL to your stable Vercel production URL after deploy, e.g. https://tell-xxxx.vercel.app
TELL_PREVIEW_URL=

# ── Grafana Cloud observability (optional) ────────────────────────────────────
# Get these from: Grafana Cloud → Connections → Add new connection → OpenTelemetry
# Traces land in Tempo; use Grafana Explore or grafana-assistant CLI to query them.
#
#   grafana-assistant prompt "Show me p95 latency for tell.diagnose spans in the last hour"
#   grafana-assistant prompt "Find any tell.diagnose spans where tell.live=false today"
#   grafana-assistant prompt "Are there errors in tell.redesign spans in the last 30 minutes?"
#
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
# Header format: Authorization=Basic <base64(grafana-instance-id:grafana-api-token)>
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <your-base64-token>
OTEL_SERVICE_NAME=tell

# ── Neon Managed Auth (hosted generation gate: /api/restyle|redesign|voice|design) ──
# Enable Auth on the Neon project before use (Console → Auth, Better Auth provider).
# The app trust/callback domain (designproof.site) is configured live in the Neon
# Auth console — NOT here; these vars point at the managed auth base URL.
NEON_AUTH_BASE_URL=
# Cookie signing secret, min 32 chars (openssl rand -base64 32)
NEON_AUTH_COOKIE_SECRET=

# ── Dodo Payments billing (Maker/Studio plans; Tip $5 pending GTM product_id) ──
# API key for /api/billing/checkout; absent → honest 503, no checkout offered.
DODO_API_KEY=
# Webhook signing secret for /api/billing/dodo/webhook (also mounted at /api/webhooks/dodo)
DODO_WEBHOOK_SECRET=
# Optional API-local overlay; defaults documented in apps/web/src/lib/dodo.ts
DODO_API_BASE_URL=
# Optional per-product overrides (live IDs are code defaults — see lib/dodo.ts)
DODO_PRODUCT_MAKER_MONTHLY=
DODO_PRODUCT_MAKER_YEARLY=
DODO_PRODUCT_STUDIO_MONTHLY=
DODO_PRODUCT_STUDIO_YEARLY=
# Tip $5 product — leave empty until GTM provides it
DODO_PRODUCT_TIP=

# ── Hosted generation plan caps (Free CEO-interim: 10/user + 20/IP per day) ──
# Maker/Studio defaults are intentionally huge placeholders; set these before
# claiming product numbers in GTM plans.
# *_CONCURRENCY = max in-flight generations per user (defaults: free 1, maker 4,
# studio 8). Enforced per-user via a Neon inflight lease; 2nd concurrent Free
# generate → 429 with Retry-After.
HOSTED_FREE_DAILY_LIMIT=
HOSTED_FREE_IP_DAILY_LIMIT=
HOSTED_FREE_CONCURRENCY=
HOSTED_MAKER_DAILY_LIMIT=
HOSTED_MAKER_IP_DAILY_LIMIT=
HOSTED_MAKER_CONCURRENCY=
HOSTED_STUDIO_DAILY_LIMIT=
HOSTED_STUDIO_IP_DAILY_LIMIT=
HOSTED_STUDIO_CONCURRENCY=
# Optional distinct hosted open-weights key for Free (falls back to GEMINI_API_KEY)
HOSTED_OPENWEIGHTS_API_KEY=
