{
  "name": "@designproof/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "designproof": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --external @designproof/core --external @designproof/schema --external @designproof/taste",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@designproof/core": "workspace:*",
    "@designproof/schema": "workspace:*",
    "@designproof/taste": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
